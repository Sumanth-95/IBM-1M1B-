  if (swb) swb.style.width = sp + '%';
  const swp = document.getElementById('soil-world-pct');
  if (swp) swp.textContent = sp + '% Complete';
  const spl = document.getElementById('soil-progress-label');
  if (spl) spl.textContent = sl + '/6 Levels';
  const apl = document.getElementById('air-progress-label');
  if (apl) apl.textContent = al + '/5 Levels';
  const wpl = document.getElementById('water-progress-label');
  if (wpl) wpl.textContent = wl + '/5 Levels';
  const am = document.getElementById('air-mission-progress');
  if (am) am.textContent = al + '/5 Complete';
  const wm = document.getElementById('water-mission-progress');
  if (wm) wm.textContent = wl + '/5 Complete';
