];
let causeSelected = null;
let causeMatches = {};
function initCauseMatch() {
  const cont = document.getElementById('cause-match-game');
  if (!cont || cont.children.length > 0) return;
  const shuffledEffects = [...CAUSE_PAIRS.map(p=>p.effect)].sort(() => Math.random()-0.5);
  cont.innerHTML = `<div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
    <div><div style="color:#b0c4de;text-align:center;margin-bottom:8px;">Causes / Actions</div>
      ${CAUSE_PAIRS.map((p,i) => `<div class="match-item" id="cause-${i}" onclick="causeClick('cause',${i},'${p.cause}','${p.effect}')">${p.cause}</div>`).join('')}
    </div>
    <div><div style="color:#b0c4de;text-align:center;margin-bottom:8px;">Effects</div>
      ${shuffledEffects.map((e,i) => `<div class="match-item" id="effect-${i}" onclick="causeClick('effect',${i},'${e}','')" data-val="${e}">${e}</div>`).join('')}
    </div>
  </div>`;
}
let causeMatchScore = 0;
function causeClick(type, idx, val, expectedEffect) {
  if (type === 'cause') {
    if (causeSelected && causeSelected.type === 'cause') {
      document.getElementById('cause-' + causeSelected.idx).classList.remove('selected');
    }
    causeSelected = { type, idx, val, expectedEffect };
    document.getElementById('cause-' + idx).classList.add('selected');
  } else {
    if (!causeSelected) return;
    if (causeSelected.expectedEffect === val) {
      document.getElementById('cause-' + causeSelected.idx).classList.replace('selected','matched');
      document.getElementById('effect-' + idx).classList.replace('selected','matched');
      causeMatchScore++;
      const res = document.getElementById('cause-match-result');
      res.innerHTML = `<div style="padding:10px;background:rgba(76,175,80,0.15);border:1px solid var(--green);border-radius:10px;">✅ Matched! ${causeMatchScore}/${CAUSE_PAIRS.length} correct</div>`;
      if (causeMatchScore >= CAUSE_PAIRS.length) awardXP(70, '+70 XP! Match master!');
    } else {
      const res = document.getElementById('cause-match-result');
