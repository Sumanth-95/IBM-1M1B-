// Load from localStorage
function loadState() {
  try {
    const s = localStorage.getItem('ecoquest_state');
    if (s) Object.assign(state, JSON.parse(s));
    state.soilExplored = new Set(state.soilExplored || []);
  } catch(e) {}
}
function saveState() {
  try {
    const s = {...state};
    s.soilExplored = [...state.soilExplored];
    localStorage.setItem('ecoquest_state', JSON.stringify(s));
  } catch(e) {}
}

