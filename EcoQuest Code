const CAUSE_PAIRS = [
  { cause: '🗑️ Improper waste disposal', effect: '🌱 Soil pollution' },
  { cause: '🧪 Chemical contamination', effect: '🌱 Soil pollution' },
  { cause: '🚗 Vehicle emissions', effect: '🌬️ Air pollution' },
