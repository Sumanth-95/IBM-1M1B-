//  LEVEL CLAIM
// ============================================================
function claimLevel(world, level, xp, badgeName, badgeIcon) {
  const key = world + '_' + level;
  if (!state.completedLevels[world]) state.completedLevels[world] = [];
  if (!state.completedLevels[world].includes(level)) {
    state.completedLevels[world].push(level);
    awardXP(xp, '+' + xp + ' XP! ' + badgeIcon);
    // Find and award badge
    const bid = BADGES_DEF.find(b => b.name === badgeName);
    if (bid) awardBadge(bid.id);
    else {
      // Match by icon
      const bid2 = BADGES_DEF.find(b => b.icon === badgeIcon);
      if (bid2) awardBadge(bid2.id);
    }
    // Update level badge indicators
    const lbadge = document.getElementById('soil-l' + level + '-badge');
    if (lbadge && world === 'soil') lbadge.textContent = '✅';
    saveState();
    updateWorldBars();
  }
  // Update XP display on world screen
  const xpEl = document.getElementById(world + '-xp-earned');
  if (xpEl) {
    const total = (state.completedLevels[world] || []).reduce((a,l2) => {
      const levelXPs = {soil:{1:50,2:60,3:70,4:60,5:70,6:80},air:{1:50,2:60,3:70,4:70,5:100},water:{1:50,2:60,3:70,4:70,5:100}};
      return a + (levelXPs[world] && levelXPs[world][l2] || 0);
    }, 0);
    xpEl.textContent = total + ' XP Earned';
  }
}

