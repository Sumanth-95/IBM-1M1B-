<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>EcoQuest: Planet Protectors 🌍</title>
<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet">
<style>
:root {
  --sky: #87CEEB; --green: #4CAF50; --dark-green: #2E7D32;
  --water: #1565C0; --light-water: #42A5F5; --soil: #8D6E63;
  --dark-soil: #5D4037; --yellow: #FFD600; --orange: #FF8F00;
  --purple: #7B1FA2; --red: #E53935; --white: #FFFFFF;
  --bg: #0a1628; --card: #1a2744; --text: #e8f4f8;
  --accent: #00e5ff; --xp: #FFD600; --badge: #FF9800;
}
* { margin:0; padding:0; box-sizing:border-box; }
body { font-family: 'Segoe UI', system-ui, sans-serif; background:var(--bg); color:var(--text); overflow-x:hidden; min-height:100vh; }

/* SCREENS */
.screen { display:none; min-height:100vh; }
.screen.active { display:block; }

/* NAV */
#main-nav {
  position:fixed; top:0; left:0; right:0; z-index:1000;
  background:rgba(10,22,40,0.95); border-bottom:2px solid var(--accent);
  display:flex; align-items:center; justify-content:space-between; padding:8px 16px;
}
#main-nav .logo { font-size:1.2rem; font-weight:800; color:var(--accent); cursor:pointer; }
#main-nav .xp-bar { display:flex; align-items:center; gap:8px; font-size:0.9rem; }
#main-nav .xp-val { color:var(--xp); font-weight:700; }
.nav-links { display:flex; gap:6px; flex-wrap:wrap; }
.nav-btn { background:transparent; border:1px solid var(--accent); color:var(--accent); padding:4px 10px; border-radius:20px; cursor:pointer; font-size:0.75rem; transition:all 0.2s; }
.nav-btn:hover, .nav-btn.active { background:var(--accent); color:var(--bg); }
.nav-btn.parent-btn { border-color:var(--badge); color:var(--badge); }
.nav-btn.parent-btn:hover { background:var(--badge); color:white; }

/* CONTENT AREA */
.content { padding-top:60px; }

/* BUTTONS */
.btn { display:inline-block; padding:12px 28px; border-radius:30px; border:none; cursor:pointer; font-size:1rem; font-weight:700; transition:all 0.2s; }
.btn-primary { background:linear-gradient(135deg,#00e5ff,#0070f3); color:white; }
.btn-green { background:linear-gradient(135deg,#4CAF50,#2E7D32); color:white; }
.btn-soil { background:linear-gradient(135deg,#8D6E63,#5D4037); color:white; }
.btn-water { background:linear-gradient(135deg,#42A5F5,#1565C0); color:white; }
.btn-air { background:linear-gradient(135deg,#80DEEA,#0097A7); color:white; }
.btn-fire { background:linear-gradient(135deg,#FF9800,#E53935); color:white; }
.btn:hover { transform:translateY(-2px); box-shadow:0 6px 20px rgba(0,0,0,0.4); }
.btn:active { transform:translateY(0); }

/* CARDS */
.card { background:var(--card); border-radius:16px; padding:20px; margin:10px; border:1px solid rgba(0,229,255,0.15); transition:all 0.3s; }
.card:hover { border-color:var(--accent); transform:translateY(-3px); }
.card h3 { margin-bottom:8px; }
.grid-2 { display:grid; grid-template-columns:repeat(auto-fit,minmax(280px,1fr)); gap:16px; padding:16px; }
.grid-3 { display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:16px; padding:16px; }

/* HERO */
.hero { text-align:center; padding:60px 20px 40px; position:relative; overflow:hidden; }
.hero h1 { font-size:clamp(2rem,5vw,4rem); font-weight:900; background:linear-gradient(135deg,#00e5ff,#4CAF50,#FFD600); -webkit-background-clip:text; -webkit-text-fill-color:transparent; background-clip:text; }
.hero p { font-size:1.2rem; color:#b0c4de; margin:16px 0 32px; max-width:600px; margin-left:auto; margin-right:auto; }
.floating { animation:float 3s ease-in-out infinite; }
@keyframes float { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-12px)} }
.pulse { animation:pulse 2s ease-in-out infinite; }
@keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.6} }

/* XP NOTIFICATION */
#xp-popup { position:fixed; top:70px; right:20px; background:var(--xp); color:var(--bg); padding:10px 20px; border-radius:20px; font-weight:800; font-size:1.1rem; z-index:9999; display:none; animation:slideIn 0.4s ease; }
@keyframes slideIn { from{transform:translateX(100px);opacity:0} to{transform:translateX(0);opacity:1} }

/* PROGRESS BAR */
.progress-container { background:rgba(255,255,255,0.1); border-radius:10px; height:12px; overflow:hidden; }
.progress-fill { height:100%; background:linear-gradient(90deg,var(--accent),var(--green)); border-radius:10px; transition:width 0.5s ease; }

/* BADGES */
.badge-item { display:inline-flex; flex-direction:column; align-items:center; gap:4px; padding:12px; background:var(--card); border-radius:12px; border:2px solid transparent; min-width:90px; }
.badge-item.earned { border-color:var(--badge); background:rgba(255,152,0,0.1); }
.badge-item.locked { opacity:0.4; filter:grayscale(0.8); }
.badge-icon { font-size:2rem; }
.badge-name { font-size:0.7rem; text-align:center; color:#b0c4de; }

/* MODAL */
.modal-overlay { position:fixed; inset:0; background:rgba(0,0,0,0.8); z-index:2000; display:none; align-items:center; justify-content:center; }
.modal-overlay.open { display:flex; }
.modal { background:var(--card); border-radius:20px; padding:30px; max-width:500px; width:90%; border:2px solid var(--accent); position:relative; max-height:80vh; overflow-y:auto; }
.modal h2 { margin-bottom:12px; color:var(--accent); }
.modal-close { position:absolute; top:12px; right:16px; background:none; border:none; color:var(--text); font-size:1.5rem; cursor:pointer; }

/* QUIZ */
.quiz-option { display:block; width:100%; text-align:left; padding:12px 18px; margin:6px 0; background:rgba(255,255,255,0.05); border:1px solid rgba(255,255,255,0.15); border-radius:10px; cursor:pointer; color:var(--text); font-size:1rem; transition:all 0.2s; }
.quiz-option:hover { background:rgba(0,229,255,0.15); border-color:var(--accent); }
.quiz-option.correct { background:rgba(76,175,80,0.3); border-color:var(--green); }
.quiz-option.wrong { background:rgba(229,57,53,0.3); border-color:var(--red); }

/* ADVENTURE MAP */
#screen-map .map-container { position:relative; min-height:80vh; display:flex; align-items:center; justify-content:center; }
.world-node { position:absolute; display:flex; flex-direction:column; align-items:center; gap:8px; cursor:pointer; transition:all 0.3s; }
.world-node:hover .world-circle { transform:scale(1.15); }
.world-circle { width:100px; height:100px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:2.5rem; border:4px solid rgba(255,255,255,0.3); transition:all 0.3s; box-shadow:0 0 20px rgba(0,0,0,0.5); }
.world-circle.air { background:radial-gradient(circle,#80DEEA,#0097A7); border-color:#00BCD4; }
.world-circle.water { background:radial-gradient(circle,#42A5F5,#1565C0); border-color:#2196F3; }
.world-circle.soil { background:radial-gradient(circle,#A1887F,#5D4037); border-color:#8D6E63; }
.world-circle.earth { background:radial-gradient(circle,#66BB6A,#2E7D32); border-color:#4CAF50; animation:glow 2s ease-in-out infinite; }
.world-circle.locked { filter:grayscale(0.7); opacity:0.6; cursor:not-allowed; }
@keyframes glow { 0%,100%{box-shadow:0 0 20px rgba(0,0,0,0.5)} 50%{box-shadow:0 0 40px rgba(76,175,80,0.8)} }
.world-label { font-weight:700; font-size:0.85rem; text-align:center; color:var(--text); }
.map-path { position:absolute; opacity:0.4; }

/* SOIL WORLD */
.soil-env { background:linear-gradient(180deg,#87CEEB 0%,#87CEEB 40%,#8BC34A 40%,#8BC34A 50%,#8D6E63 50%,#5D4037 80%,#3E2723 100%); border-radius:16px; min-height:300px; position:relative; overflow:hidden; display:flex; flex-direction:column; }
.sky-layer { flex:0 0 40%; position:relative; display:flex; align-items:flex-end; justify-content:space-around; padding:20px; }
.ground-layer { flex:0 0 20%; background:#8BC34A; display:flex; align-items:center; justify-content:space-around; padding:8px; }
.underground-layer { flex:1; background:linear-gradient(180deg,#8D6E63,#5D4037); display:flex; align-items:center; justify-content:space-around; padding:16px; }
.clickable-obj { cursor:pointer; font-size:2.5rem; transition:transform 0.2s; display:inline-block; }
.clickable-obj:hover { transform:scale(1.3) rotate(5deg); }
.info-bubble { position:absolute; background:rgba(10,22,40,0.95); border:2px solid var(--accent); border-radius:12px; padding:12px; max-width:220px; font-size:0.85rem; z-index:100; pointer-events:none; }

/* DRAG AND DROP */
.drag-item { background:var(--card); border:2px solid rgba(255,255,255,0.2); border-radius:10px; padding:10px 16px; cursor:grab; user-select:none; font-size:1.1rem; transition:all 0.2s; display:inline-flex; align-items:center; gap:6px; }
.drag-item:hover { border-color:var(--accent); transform:scale(1.05); }
.drag-item.dragging { opacity:0.5; cursor:grabbing; }
.drop-zone { min-height:120px; border:3px dashed rgba(255,255,255,0.3); border-radius:16px; padding:16px; transition:all 0.2s; }
.drop-zone.drag-over { border-color:var(--accent); background:rgba(0,229,255,0.1); }
.drop-zone.correct { border-color:var(--green); background:rgba(76,175,80,0.1); }

/* SCENARIO GAME */
.scenario-box { background:rgba(0,229,255,0.08); border:2px solid var(--accent); border-radius:16px; padding:24px; margin:16px 0; }
.scenario-choices { display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-top:16px; }
.choice-btn { padding:14px; border-radius:12px; border:2px solid rgba(255,255,255,0.2); background:rgba(255,255,255,0.05); cursor:pointer; color:var(--text); font-size:0.95rem; transition:all 0.2s; }
.choice-btn:hover { border-color:var(--accent); background:rgba(0,229,255,0.1); }
.choice-btn.correct { border-color:var(--green); background:rgba(76,175,80,0.2); }
.choice-btn.wrong { border-color:var(--red); background:rgba(229,57,53,0.2); }

/* ECO ACTIONS */
.eco-action { display:flex; align-items:center; gap:12px; padding:12px 16px; background:rgba(255,255,255,0.05); border-radius:10px; margin:6px 0; cursor:pointer; transition:all 0.2s; border:1px solid transparent; }
.eco-action:hover { border-color:var(--green); background:rgba(76,175,80,0.1); }
.eco-action.done { border-color:var(--green); background:rgba(76,175,80,0.15); }
.eco-check { width:22px; height:22px; border-radius:50%; border:2px solid var(--green); display:flex; align-items:center; justify-content:center; flex-shrink:0; font-size:0.75rem; }
.eco-action.done .eco-check { background:var(--green); }

/* CONNECTION CYCLE */
.cycle-item { background:var(--card); border-radius:12px; padding:16px 20px; cursor:pointer; transition:all 0.3s; border:2px solid transparent; }
.cycle-item:hover, .cycle-item.active { border-color:var(--accent); background:rgba(0,229,255,0.1); }
.cycle-arrow { text-align:center; font-size:1.5rem; color:var(--accent); }

/* PARENT MODE */
#screen-parent { background:linear-gradient(135deg,#0a1628,#1a2744); }
.parent-lock { text-align:center; padding:80px 20px; }
.parent-lock input { background:rgba(255,255,255,0.1); border:2px solid var(--accent); color:white; padding:12px 20px; border-radius:10px; font-size:1rem; width:200px; text-align:center; }

/* CERTIFICATE */
.certificate { background:linear-gradient(135deg,#1a2744,#0d1f33); border:4px solid var(--xp); border-radius:24px; padding:40px; text-align:center; max-width:600px; margin:20px auto; position:relative; }
.cert-seal { font-size:5rem; animation:float 3s ease-in-out infinite; }

/* LEVEL INDICATOR */
.level-btn { display:flex; align-items:center; gap:10px; padding:14px 18px; background:rgba(255,255,255,0.05); border-radius:12px; border:1px solid rgba(255,255,255,0.1); cursor:pointer; transition:all 0.2s; width:100%; text-align:left; }
.level-btn:hover { border-color:var(--accent); background:rgba(0,229,255,0.08); }
.level-btn.completed { border-color:var(--green); }
.level-btn .level-icon { font-size:1.8rem; }
.level-num { font-size:0.75rem; color:#b0c4de; }

/* MATCH GAME */
.match-pair { display:flex; gap:16px; align-items:center; margin:10px 0; }
.match-item { flex:1; padding:10px; background:rgba(255,255,255,0.07); border-radius:10px; border:2px solid transparent; cursor:pointer; transition:all 0.2s; text-align:center; }
.match-item.selected { border-color:var(--accent); background:rgba(0,229,255,0.15); }
.match-item.matched { border-color:var(--green); background:rgba(76,175,80,0.15); }

/* GARDEN GAME */
.garden-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:12px; padding:16px; }
.garden-cell { aspect-ratio:1; background:rgba(93,64,55,0.6); border-radius:12px; border:2px dashed rgba(255,255,255,0.2); display:flex; align-items:center; justify-content:center; font-size:2rem; cursor:pointer; transition:all 0.3s; }
.garden-cell.planted { background:rgba(76,175,80,0.3); border-color:var(--green); border-style:solid; }
.garden-cell:hover { border-color:var(--green); }

/* TABS */
.tabs { display:flex; gap:8px; padding:16px; flex-wrap:wrap; border-bottom:1px solid rgba(255,255,255,0.1); }
.tab-btn { padding:8px 18px; border-radius:20px; border:1px solid rgba(255,255,255,0.2); background:transparent; color:var(--text); cursor:pointer; font-size:0.9rem; transition:all 0.2s; }
.tab-btn.active { background:var(--accent); color:var(--bg); border-color:var(--accent); }
.tab-content { display:none; padding:16px; }
.tab-content.active { display:block; }

/* HEADER SECTION */
.section-header { padding:24px 20px 8px; }
.section-header h2 { font-size:1.8rem; }
.section-header p { color:#b0c4de; margin-top:6px; }

/* MINI GAME ZONE */
.mini-game-zone { background:rgba(255,255,255,0.03); border-radius:16px; padding:20px; min-height:200px; }

/* HEALTH BAR */
.health-bar { display:flex; align-items:center; gap:10px; margin:12px 0; }
.health-bar span { min-width:80px; font-size:0.85rem; color:#b0c4de; }

/* TOOLTIP */
.tooltip { position:relative; }
.tooltip-text { visibility:hidden; background:var(--card); border:1px solid var(--accent); color:var(--text); padding:6px 10px; border-radius:8px; position:absolute; bottom:110%; left:50%; transform:translateX(-50%); white-space:nowrap; font-size:0.8rem; z-index:999; }
.tooltip:hover .tooltip-text { visibility:visible; }

/* STARS */
.stars { color:var(--xp); font-size:1.5rem; letter-spacing:4px; }

/* SECTION DIVIDER */
.divider { height:2px; background:linear-gradient(90deg,transparent,var(--accent),transparent); margin:24px 0; }

/* WORLD TITLE BANNER */
.world-banner { padding:30px 20px; text-align:center; border-radius:0 0 24px 24px; }
.world-banner.soil-banner { background:linear-gradient(135deg,#3E2723,#5D4037,#8BC34A); }
.world-banner.air-banner { background:linear-gradient(135deg,#006064,#0097A7,#80DEEA); }
.world-banner.water-banner { background:linear-gradient(135deg,#0D47A1,#1565C0,#42A5F5); }
.world-banner h1 { font-size:2.2rem; font-weight:900; }
.world-banner p { font-size:1rem; color:rgba(255,255,255,0.85); margin-top:8px; }

/* SCROLLBAR */
::-webkit-scrollbar { width:6px; }
::-webkit-scrollbar-track { background:var(--bg); }
::-webkit-scrollbar-thumb { background:var(--accent); border-radius:3px; }

/* RESPONSIVE */
@media(max-width:600px) {
  .scenario-choices { grid-template-columns:1fr; }
  .world-circle { width:70px; height:70px; font-size:1.8rem; }
  .nav-links { display:none; }
}

/* CHAT BOT */
#watson-chat { position:fixed; bottom:20px; right:20px; z-index:3000; }
.chat-fab { width:56px; height:56px; background:linear-gradient(135deg,#FF9800,#E53935); border-radius:50%; border:none; cursor:pointer; font-size:1.5rem; box-shadow:0 4px 16px rgba(0,0,0,0.4); transition:all 0.2s; display:none; }
.chat-fab:hover { transform:scale(1.1); }
.chat-window { position:fixed; bottom:90px; right:20px; width:350px; height:500px; background:var(--card); border-radius:20px; border:2px solid var(--badge); overflow:hidden; display:none; flex-direction:column; box-shadow:0 8px 32px rgba(0,0,0,0.6); }
.chat-window.open { display:flex; }
.chat-header { background:linear-gradient(135deg,#E65100,#FF8F00); padding:14px 18px; display:flex; align-items:center; justify-content:space-between; }
.chat-header h4 { font-size:0.95rem; }
.chat-header span { font-size:0.75rem; opacity:0.85; }
.chat-close { background:none; border:none; color:white; font-size:1.3rem; cursor:pointer; }
.chat-messages { flex:1; overflow-y:auto; padding:16px; display:flex; flex-direction:column; gap:10px; }
.chat-msg { padding:10px 14px; border-radius:14px; max-width:85%; font-size:0.88rem; line-height:1.5; }
.chat-msg.bot { background:rgba(0,229,255,0.15); border:1px solid rgba(0,229,255,0.3); align-self:flex-start; }
.chat-msg.user { background:linear-gradient(135deg,#FF9800,#E65100); align-self:flex-end; }
.chat-input-row { display:flex; gap:8px; padding:12px; border-top:1px solid rgba(255,255,255,0.1); }
.chat-input-row input { flex:1; background:rgba(255,255,255,0.08); border:1px solid rgba(255,255,255,0.2); border-radius:20px; padding:8px 14px; color:white; font-size:0.9rem; }
.chat-input-row button { background:var(--badge); border:none; color:white; border-radius:50%; width:36px; height:36px; cursor:pointer; font-size:1rem; }

/* ANIMATIONS */
.bounce-in { animation:bounceIn 0.5s cubic-bezier(0.68,-0.55,0.265,1.55); }
@keyframes bounceIn { from{transform:scale(0);opacity:0} to{transform:scale(1);opacity:1} }
.shake { animation:shake 0.4s; }
@keyframes shake { 0%,100%{transform:translateX(0)} 25%{transform:translateX(-8px)} 75%{transform:translateX(8px)} }
.grow-in { animation:growIn 0.6s ease-out; }
@keyframes growIn { from{opacity:0;transform:translateY(20px)} to{opacity:1;transform:translateY(0)} }
.clouds { animation:cloudMove 20s linear infinite; }
@keyframes cloudMove { from{transform:translateX(-100px)} to{transform:translateX(calc(100vw + 100px))} }
</style>
<style>
