function awardBadge(id) {
  if (!state.badges.includes(id)) {
    state.badges.push(id);
    saveState();
    renderBadges();
    const badge = BADGES_DEF.find(b => b.id === id);
    if (badge) showXPPopup('Badge: ' + badge.name + ' ' + badge.icon);
  }
}

function renderBadges() {
  const grid = document.getElementById('badges-grid');
  if (!grid) return;
  grid.innerHTML = '';
  BADGES_DEF.forEach(b => {
    const earned = state.badges.includes(b.id);
    grid.innerHTML += `<div class="badge-item ${earned?'earned':'locked'}">
      <div class="badge-icon">${b.icon}</div>
      <div class="badge-name">${b.name}</div>
      <div style="font-size:0.65rem;color:${earned?'var(--xp)':'#666'};margin-top:2px;">${earned?'Earned!':'Locked'}</div>
    </div>`;
  });
  const cnt = document.getElementById('badges-earned-count');
  if (cnt) cnt.textContent = state.badges.length + ' / ' + BADGES_DEF.length + ' badges earned';
  const cb = document.getElementById('cert-btn');
  if (cb) cb.style.display = state.badges.length > 0 ? 'inline-block' : 'none';
  if (document.getElementById('parent-badges-val')) updateParentDashboard();
}

