function showScreen(name) {
  document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
  const el = document.getElementById('screen-' + name);
  if (el) { el.classList.add('active'); window.scrollTo(0,0); }
  if (name === 'badges') renderBadges();
  if (name === 'earthguardian') initGuardian();
  if (name === 'games') initSortingGame();
  if (name === 'certificate') updateCertificate();
  if (name === 'parent') {
    if (state.parentLoggedIn) {
      document.getElementById('parent-login-area').style.display = 'none';
      document.getElementById('parent-dashboard').style.display = 'block';
      setChatAvailability(true);
      updateParentDashboard();
    } else {
      document.getElementById('parent-login-area').style.display = 'flex';
      document.getElementById('parent-dashboard').style.display = 'none';
      setChatAvailability(false);
    }
  }
}

function showTab(world, tab) {
  const allTabs = document.querySelectorAll(`#screen-${world} .tab-content`);
  allTabs.forEach(t => t.classList.remove('active'));
  const target = document.getElementById(`${world}-tab-${tab}`);
  if (target) target.classList.add('active');
  const allBtns = document.querySelectorAll(`#screen-${world} .tab-btn`);
  allBtns.forEach(b => b.classList.remove('active'));
  // Find matching button by text content
  allBtns.forEach(b => { if (b.textContent.toLowerCase().includes(tab) || b.getAttribute('onclick') && b.getAttribute('onclick').includes(`'${tab}'`)) b.classList.add('active'); });
  // Init games on demand
  if (world === 'soil' && tab === 'detective') initDetectiveGame();
  if (world === 'soil' && tab === 'save') initCleanupGame();
  if (world === 'soil' && tab === 'food') initGardenGrid();
  if (world === 'soil' && tab === 'life') initMatchGame();
  if (world === 'soil' && tab === 'guardian') initScenarios();
  if (world === 'air' && tab === 'quiz') initAirQuiz();
  if (world === 'water' && tab === 'quiz') initWaterQuiz();
  if (world === 'air' && tab === 'levels') refreshAirProgress();
  if (world === 'water' && tab === 'levels') refreshWaterProgress();
  if (world === 'games' && tab === 'healthy') initHealthyGame();
  if (world === 'games' && tab === 'match') initCauseMatch();
  if (world === 'games' && tab === 'garden') initGreenGarden();
}

function tryEarthGuardian() {
  const done = state.completedLevels.soil.length + state.completedLevels.air.length + state.completedLevels.water.length;
