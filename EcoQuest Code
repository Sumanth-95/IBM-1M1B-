function setChatAvailability(enabled) {
  const host = document.getElementById('watson-chat');
  const fab = document.getElementById('chat-fab-btn');
  const win = document.getElementById('chat-window');
  if (!host || !fab) return;
  host.classList.toggle('chat-enabled', !!enabled);
  host.classList.toggle('chat-disabled', !enabled);
  fab.setAttribute('aria-hidden', enabled ? 'false' : 'true');
  if (!enabled && win) win.classList.remove('open');
}

function togglePinVisibility() {
  const input = document.getElementById('parent-pin');
  if (!input) return;
  input.type = input.type === 'password' ? 'text' : 'password';
}

function parentLogin() {
  const input = document.getElementById('parent-pin');
  const pin = input ? input.value.trim() : '';
  const err = document.getElementById('pin-error');

  if (pin === '1234' || pin.toLowerCase() === 'ecoquest') {
    state.parentLoggedIn = true;
    document.getElementById('parent-login-area').style.display = 'none';
    document.getElementById('parent-dashboard').style.display = 'block';
    setChatAvailability(true);
    updateParentDashboard();
    saveState();

    // Fresh adult-session greeting and visible assistant button.
    const messages = document.getElementById('chat-messages');
    if (messages) {
      messages.innerHTML = `<div class="chat-msg bot"><strong>🤖 IBM Bob</strong><br>Welcome to the Adult Area! I can help you discuss Air, Water, and Soil Pollution, explain EcoQuest progress, and suggest teaching ideas. 🌍</div>`;
    }
    setTimeout(() => openChat(), 160);
  } else {
    if (err) err.textContent = '❌ Incorrect PIN. Try: 1234';
    if (input) {
      input.classList.remove('shake');
      void input.offsetWidth;
      input.classList.add('shake');
      setTimeout(() => input.classList.remove('shake'), 500);
      input.focus();
      input.select();
    }
  }
}

function parentLogout() {
  state.parentLoggedIn = false;
  document.getElementById('parent-login-area').style.display = 'flex';
  document.getElementById('parent-dashboard').style.display = 'none';
  setChatAvailability(false);
  const pin = document.getElementById('parent-pin');
  if (pin) { pin.value = ''; pin.type = 'password'; }
  saveState();
}

function updateParentDashboard() {
  const map = {
    'parent-xp-val': state.xp,
    'parent-badges-val': state.badges.length,
    'parent-actions-val': state.actionsCompleted,
    'parent-level-val': state.level
  };
  Object.entries(map).forEach(([id, val]) => {
    const el = document.getElementById(id);
    if (el) el.textContent = val;
  });
}

