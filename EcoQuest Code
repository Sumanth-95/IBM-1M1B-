const MATCH_PAIRS = [
  { organism: '🪱 Earthworm', role: 'Helps mix and aerate soil structure' },
  { organism: '🌱 Plant Roots', role: 'Take water and nutrients from soil' },
  { organism: '🍄 Fungi', role: 'Break down organic material' },
  { organism: '🐜 Ants', role: 'Create tunnels improving drainage' },
  { organism: '🦠 Microorganisms', role: 'Recycle nutrients in soil' },
];
let matchSelected = null;
let matchCorrect = 0;
function initMatchGame() {
  const game = document.getElementById('match-game');
  if (!game || game.children.length > 0) return;
  const shuffledRoles = [...MATCH_PAIRS.map(p=>p.role)].sort(() => Math.random()-0.5);
  game.innerHTML = `<div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
    <div><div style="color:#b0c4de;font-size:0.85rem;margin-bottom:8px;text-align:center;">Organisms</div>${MATCH_PAIRS.map((p,i) => `<div class="match-item" id="org-${i}" onclick="matchClick('org',${i},'${p.role}')">${p.organism}</div>`).join('')}</div>
    <div><div style="color:#b0c4de;font-size:0.85rem;margin-bottom:8px;text-align:center;">Roles</div>${shuffledRoles.map((r,i) => `<div class="match-item" id="role-${i}" onclick="matchClick('role',${i},'${r}')">${r}</div>`).join('')}</div>
  </div>`;
}
function matchClick(type, idx, value) {
  if (!matchSelected) {
    matchSelected = { type, idx, value };
    document.getElementById(type + '-' + idx).classList.add('selected');
  } else {
    if (matchSelected.type === type) {
      document.getElementById(matchSelected.type + '-' + matchSelected.idx).classList.remove('selected');
      matchSelected = { type, idx, value };
      document.getElementById(type + '-' + idx).classList.add('selected');
    } else {
      const a = matchSelected.value, b = value;
      const isMatch = MATCH_PAIRS.some(p => (p.organism.includes(a.split(' ')[1]||a) || a === p.organism) && p.role === b) ||
                      MATCH_PAIRS.some(p => p.organism === a && p.role === b) ||
                      MATCH_PAIRS.some(p => p.role === a && p.organism.includes(b.split(' ')[1]||b));
      const correctMatch = MATCH_PAIRS.some(p => {
        return (matchSelected.type === 'org' && a === p.organism && b === p.role) ||
               (matchSelected.type === 'role' && a === p.role && b === p.organism);
      });
      if (correctMatch) {
        document.getElementById(matchSelected.type + '-' + matchSelected.idx).classList.replace('selected','matched');
        document.getElementById(type + '-' + idx).classList.replace('selected','matched');
        matchCorrect++;
        const result = document.getElementById('match-result');
        result.innerHTML = `<div style="padding:10px;background:rgba(76,175,80,0.15);border:1px solid var(--green);border-radius:10px;">✅ Correct match! ${matchCorrect}/5 done</div>`;
        if (matchCorrect >= 5) { const btn = document.getElementById('l5-claim-btn'); if (btn) btn.style.display = 'inline-block'; }
      } else {
        document.getElementById(matchSelected.type + '-' + matchSelected.idx).classList.remove('selected');
        document.getElementById(type + '-' + idx).classList.add('selected');
        const result = document.getElementById('match-result');
        result.innerHTML = `<div style="padding:10px;background:rgba(229,57,53,0.15);border:1px solid var(--red);border-radius:10px;">🔄 Not quite — try again!</div>`;
