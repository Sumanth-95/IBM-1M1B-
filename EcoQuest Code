}
function refreshMissionCards(world) {
  const completed = state.completedLevels[world] || [];
  document.querySelectorAll(`#screen-${world} .mission-card`).forEach(card => {
    const level = Number(card.dataset.level);
    const done = completed.includes(level);
    card.classList.toggle('mission-completed', done);
    if (done) card.setAttribute('data-status','✅ Completed');
    else card.removeAttribute('data-status');
    const claim = card.querySelector('.mission-claim');
    if (claim && done) { claim.textContent = '✅ Completed'; claim.disabled = true; claim.style.display = 'inline-flex'; }
  });
}
