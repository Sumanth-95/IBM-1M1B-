function updateWorldBars() {
  const sl = state.completedLevels.soil.length;
  const al = state.completedLevels.air.length;
  const wl = state.completedLevels.water.length;
  const sp = Math.min(100, Math.round(sl/6*100)), ap = Math.min(100, Math.round(al/5*100)), wp = Math.min(100, Math.round(wl/5*100));
  ['soil-bar','air-bar','water-bar'].forEach((id,i) => {
    const el = document.getElementById(id);
    if (el) el.style.width = [sp,ap,wp][i] + '%';
  });
