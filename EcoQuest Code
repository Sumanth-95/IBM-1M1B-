  'curriculum': 'EcoQuest covers: Air Pollution (causes, effects, safe actions), Water Pollution (plastic, chemicals, conservation), Soil Pollution (waste, organisms, food chain), Pollution Connection (how systems interact), and Earth Guardian Challenge (integrated decision-making). 📚',
  'default': 'That\'s a great question! EcoQuest: Planet Protectors teaches children aged 8–15 about Air, Water, and Soil Pollution through interactive games and missions. I\'m here to help parents and teachers understand the curriculum. Could you be more specific — are you asking about a particular world, badge, or teaching approach? 🌍'
};

function toggleChat() {
  if (!state.parentLoggedIn) return;
  const win = document.getElementById('chat-window');
  if (!win) return;
  win.classList.toggle('open');
  if (win.classList.contains('open')) {
    const input = document.getElementById('chat-input');
    if (input) setTimeout(() => input.focus(), 80);
    const messages = document.getElementById('chat-messages');
    if (messages) messages.scrollTop = messages.scrollHeight;
  }
}

function openChat() {
  if (!state.parentLoggedIn) return;
  setChatAvailability(true);
  const win = document.getElementById('chat-window');
  if (win) win.classList.add('open');
  const input = document.getElementById('chat-input');
  if (input) setTimeout(() => input.focus(), 100);
  const messages = document.getElementById('chat-messages');
  if (messages) messages.scrollTop = messages.scrollHeight;
}

function escapeChatText(text) {
  return String(text).replace(/[&<>'"]/g, ch => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[ch]));
}

function addChatMessage(type, text) {
  const messages = document.getElementById('chat-messages');
  if (!messages) return;
  const div = document.createElement('div');
  div.className = 'chat-msg ' + type;
  if (type === 'bot') div.innerHTML = '<strong>🤖 IBM Bob</strong><br>' + escapeChatText(text);
  else div.textContent = text;
  messages.appendChild(div);
  messages.scrollTop = messages.scrollHeight;
}

function findBotResponse(msg) {
  const lower = msg.toLowerCase();
  if (lower.includes('air')) return BOT_RESPONSES.air;
  if (lower.includes('water')) return BOT_RESPONSES.water;
  if (lower.includes('soil') || lower.includes('dirt')) return BOT_RESPONSES.soil;
  if (lower.includes('badge')) return BOT_RESPONSES.badge;
  if (lower.includes('xp') || lower.includes('point')) return BOT_RESPONSES.xp;
  if (lower.includes('level') || lower.includes('world')) return BOT_RESPONSES.level;
  if (lower.includes('hazard') || lower.includes('chemical') || lower.includes('battery') || lower.includes('danger')) return BOT_RESPONSES.hazard;
  if (lower.includes('teach') || lower.includes('tip') || lower.includes('classroom') || lower.includes('school')) return BOT_RESPONSES.teach;
  if (lower.includes('curriculum') || lower.includes('learn') || lower.includes('topic')) return BOT_RESPONSES.curriculum;
  return BOT_RESPONSES.default;
}

function askBobQuick(topic) {
  if (!state.parentLoggedIn) return;
  const map = {
    air: 'Tell me about air pollution in EcoQuest.',
    water: 'Tell me about water pollution in EcoQuest.',
    soil: 'Tell me about soil pollution in EcoQuest.',
    teach: 'Give me teaching tips for EcoQuest.',
    curriculum: 'Explain the EcoQuest curriculum.'
  };
  const message = map[topic] || topic;
  const input = document.getElementById('chat-input');
  if (input) input.value = message;
  openChat();
  sendChat();
}

function sendChat() {
  if (!state.parentLoggedIn) return;
  const input = document.getElementById('chat-input');
  if (!input) return;
  const msg = input.value.trim();
  if (!msg) return;
  addChatMessage('user', msg);
  input.value = '';

  const resp = findBotResponse(msg);
  setTimeout(() => addChatMessage('bot', resp), 500);
}

